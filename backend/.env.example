# Existing Dentora model providers
GEMINI_API_KEY=
GROQ_API_KEY=
DASHSCOPE_API_KEY=

# Persistent zero-cost RAG
PINECONE_API_KEY=
PINECONE_INDEX_NAME=dentora-knowledge
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_EMBED_MODEL=llama-text-embed-v2
PINECONE_EMBED_DIMENSION=1024

# Protect write/delete knowledge-base endpoints.
# Generate a long random value and keep it only in Render/local .env.
DENTORA_ADMIN_KEY=

# Owner access for your own trusted browser/device.
# Enter this once in Dentora; owner access is remembered locally.
# Never share this value with testers and do not reuse DENTORA_ADMIN_KEY.
DENTORA_OWNER_ACCESS_CODE=

# Private beta access for invited students.
# Use a DIFFERENT value from both owner/admin keys.
# Share only this beta code with invited testers.
DENTORA_BETA_ACCESS_CODE=

# Public/private beta safety controls
DENTORA_ALLOWED_ORIGINS=https://drmes-dev.github.io
MAX_TEMP_PDF_MB=20
MAX_TEMP_PDF_PAGES=500
SESSION_PDF_TTL_SECONDS=14400
CHAT_RATE_LIMIT=30
CHAT_RATE_WINDOW_SECONDS=600
PDF_RATE_LIMIT=3
PDF_RATE_WINDOW_SECONDS=3600

# Optional RAG tuning
RAG_CHUNK_SIZE=1800
RAG_CHUNK_OVERLAP=250
RAG_CANDIDATES=18
RAG_CONTEXT_CHUNKS=7
RAG_MIN_SCORE=0.20

# Optional web-ingestion limits
MAX_WEB_INGEST_MB=45
MAX_WEB_OCR_PAGES=30

# Optional local Windows OCR helpers
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\path\to\poppler\Library\bin
